rust_binary {
    name: "vendor.lineage.touchinjector-service.default",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["vendor.lineage.touchinjector-service.default.rc"],
    vintf_fragments: ["vendor.lineage.touchinjector-service.default.xml"],
    rustlibs: [
        "libanyhow",
        "libnix",
        "libtokio",
        "libtokio_util",
        "libevdev_rs",
        "libchrono",
        "libbyteorder",
        "librustutils",
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libfutures",
        "libtokio_stream",
        "vendor.lineage.touchinjector-V1-rust"
    ],
    proc_macros: ["libasync_trait"],
    shared_libs: ["libcutils"],
    srcs: ["main.rs"],
    lints: "none",
    clippy_lints: "none",
}
